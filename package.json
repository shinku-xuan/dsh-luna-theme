{
  "name": "dsh-luna-theme",
  "version": "0.15.0",
  "private": true,
  "description": "Luna theme for DSH, with a balance widget, memory badge, Asahi desktop pet and an optional title opening with voice playback.",
  "license": "MIT",
  "type": "module",
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./lib/client.js",
    "./widget": "./src/host/widget.js",
    "./pet": "./src/host/pet.js",
    "./opening": "./src/host/opening.js",
    "./package.json": "./package.json",
    "./backgrounds": "./resources/backgrounds.json",
    "./background-types": {
      "types": "./src/shared/background-types.d.ts"
    }
  },
  "files": [
    "src",
    "lib/client.js",
    "resources/backgrounds.json",
    "scripts/build-client.mjs",
    "assets",
    "persona/asahi-chat.md",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
